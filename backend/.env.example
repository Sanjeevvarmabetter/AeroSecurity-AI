# Copy to .env (never commit .env). All values below are placeholders.
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false

DATABASE_URL=postgresql+psycopg://aerosec:CHANGE_ME@localhost:5432/aerosec
CORS_ORIGINS=["http://localhost:5173"]

# AI (used from Phase 6)
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Auth: bearer tokens per role. Leave empty to disable a role. Generate: openssl rand -hex 24
API_TOKEN_VIEWER=
API_TOKEN_ANALYST=
API_TOKEN_ADMIN=
RATE_LIMIT_PER_MINUTE=120

# OpenSky live API (disabled by default; see docs/data-sources.md). Credentials: OAuth2 client credentials.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
OPENSKY_MIN_INTERVAL_S=10
