# Copy to .env and fill in. NEVER commit .env (it is gitignored). All values here are placeholders.

# --- Database / ports (docker compose) ---------------------------------------------------------------
POSTGRES_PASSWORD=CHANGE_ME
# Host ports; change if 5432 / 8000 / 8080 are already taken on your machine.
DB_HOST_PORT=5432
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=8080

# --- API authentication: bearer tokens per role (viewer < analyst < admin) -------------------------
# Generate each with:  openssl rand -hex 24      An empty token disables that role.
API_TOKEN_VIEWER=
API_TOKEN_ANALYST=
API_TOKEN_ADMIN=

# --- AI (optional). Model names are never hardcoded: pick any you have access to. --------------
AI_PROVIDER=ollama                                   # ollama | openrouter
OLLAMA_BASE_URL=http://host.docker.internal:11434    # Ollama running on the host
OLLAMA_MODEL=                                        # e.g. a model you have pulled with `ollama pull`
OPENROUTER_API_KEY=                                  # cloud provider; server-side only, never sent to the browser
OPENROUTER_MODEL=
AI_TIMEOUT_S=120                                     # raise (e.g. 300) for large local models
AI_MAX_OUTPUT_TOKENS=1800                            # reasoning models may need much more (up to 8000)

# --- OpenSky live API (optional; DISABLED by default, see docs/data-sources.md) -----------------
# OAuth2 client credentials from your OpenSky account (API Client section). Read OpenSky's terms first.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
OPENSKY_MIN_INTERVAL_S=10
